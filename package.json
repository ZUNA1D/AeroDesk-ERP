{
  "name": "aerodesk",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AeroDesk - Modern Travel & Aviation Agency Management ERP",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.5",
    "@rollup/rollup-linux-x64-musl": "4.62.5"
  }
}
